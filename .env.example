# Required — DeepSeek API key. The app talks to DeepSeek through its
# Anthropic-compatible endpoint (see ANTHROPIC_BASE_URL below).
# Get a key at https://platform.deepseek.com/api_keys
ANTHROPIC_API_KEY=

# Required — point the Anthropic SDK at DeepSeek's Anthropic-compatible endpoint.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional — model and reasoning effort overrides.
# deepseek-flash (default, cheap) or deepseek-v4-pro (higher quality).
# ANTHROPIC_MODEL=deepseek-flash
# ANTHROPIC_EFFORT=high

# Local SQLite database.
DATABASE_URL="file:./dev.db"

# Optional — raises the GitHub API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# 邮件发送（QQ 邮箱 SMTP）。不填 SMTP_USER / SMTP_PASS 时邮件为 dry-run，只打印收件人。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=授权码（不是 QQ 登录密码，获取方法见 README「发送邮件」）

# 发件人。默认直接用 SMTP_USER（QQ 邮箱要求发件地址 = 登录账号）。
# NEWSLETTER_FROM=

# 周报底部跳转到仪表盘的链接。不设置时会自动探测本机局域网 IP（换 WiFi 也不用改）。
# 部署到公网后，取消下面这行的注释并填成真实域名。
# SITE_URL="http://localhost:3000"
